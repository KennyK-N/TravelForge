      "name": "Email Reminder Cron Job"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\n\nconst { latitude, longitude } = item.coordinates;\n\nconst options = {\n  method: 'GET',\n  url: 'https://api.open-meteo.com/v1/forecast',\n  qs: {\n    latitude,\n    longitude,\n    daily: 'temperature_2m_mean,precipitation_sum',\n    forecast_days: 1,\n  },\n  headers: {\n    Accept: 'application/json',\n  },\n};\n\ntry {\n  const response = await this.helpers.httpRequest(options);\n\n  item.temp = response.daily.temperature_2m_mean[0];\n  item.precipitation = response.daily.precipitation_sum[0];\n} catch (error) {\n  // Keep the item unchanged if request fails\n}\n\nreturn { json: item };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        384
      ],
      "id": "668100d7-aae0-4b8b-9bdb-8b2149d5558e",
      "name": "Retrieve Corresponding Weather Information"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE \"weather\"\nSET\n    \"temp\" = {{ $json.temp }},\n    \"precipitation\" = {{ $json.precipitation }}\nWHERE \"taskId\" = '{{ $json.id }}';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        48,
        384
      ],
      "id": "3e8bdd1d-f144-4569-b019-90d7754b876f",
      "name": "Update Corresponding Entries",
      "credentials": {
        "postgres": {
          "id": "mLAXyJof9ARz6CRz",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH constants AS (\n    SELECT 'America/Los_Angeles' AS time_zone\n)\n\nSELECT DISTINCT\n  t.\"id\",\n  t.\"startDate\",\n  t.\"endDate\",\n  t.\"userId\",\n  t.\"createdAt\",\n  t.\"toCity\",\n  t.\"toCountry\",\n  t.\"planName\",\n  u.email,\n  u.\"name\"\nFROM task t\nCROSS JOIN constants c\nINNER JOIN \"user\" u\n  ON u.id = t.\"userId\"\nINNER JOIN \"setting\" s\n  ON s.\"userId\" = u.id\nWHERE (t.\"startDate\" AT TIME ZONE 'UTC')::date\n      = ((now() AT TIME ZONE c.time_zone)::date + INTERVAL '1 day')\n  AND s.\"emailNotification\" = TRUE;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -464,
        192
      ],
      "id": "aff5e513-ac00-4ce7-b86a-245e49900e76",
      "name": "Retrieve Trips Scheduled for Next Day",
      "credentials": {
        "postgres": {
          "id": "mLAXyJof9ARz6CRz",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM session\nWHERE session.\"expiresAt\" < NOW();",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
