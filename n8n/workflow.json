      "id": "6f422f0d-4d9c-460f-9036-3578bf00794e",
      "name": "Delete Outdated Entries"
    },
    {
      "parameters": {
        "sendHTML": true,
        "subject": "=Trip Reminder for {{ $json.planName }}",
        "htmlContent": "=<h2>Trip Reminder ✈️</h2>\n\n<p>Hi {{ $json.name }},</p>\n\n<p>This is a reminder that your trip to <strong>{{ $json.toCity }}, {{ $json.toCountry }}</strong> is starting tomorrow!</p>\n\n<p>\n  <strong>Start date:</strong>\n  {{ new Date($json.startDate).toLocaleDateString('en-CA') }}<br>\n  <strong>End date:</strong>\n  {{ new Date($json.endDate).toLocaleDateString('en-CA') }}\n</p>\n\n<p>Have a great trip and enjoy your travels! 🌍</p>\n\n<p>Safe travels,<br>\nTripPlanner-AI</p>",
        "sender": "personaltestinga166@gmail.com",
        "receipients": "={{ $json.email }}",
        "additionalFields": {},
        "requestOptions": {}
      },
      "type": "n8n-nodes-base.sendInBlue",
      "typeVersion": 1,
      "position": [
        -224,
        192
      ],
      "id": "e19c4062-879f-4ec9-a0df-79dd6ad256f2",
      "name": "Send Reminder Emails"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    w.\"taskId\" AS id,\n    t.\"userId\",\n    t.\"data\" -> 'itinerary' -> 0 -> 'coordinates' -> 0 AS coordinates\nFROM \"task\" AS t\nINNER JOIN \"weather\" AS w\n    ON t.id = w.\"taskId\"\nWHERE t.\"data\" -> 'itinerary' IS NOT NULL\n  AND t.\"data\" -> 'itinerary' <> '[]'::jsonb",
        "options": {}
      },
